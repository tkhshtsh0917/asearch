{
  "name": "asearch-wasm",
  "version": "0.1.0",
  "type": "module",
  "description": "Asearch wildcard approximate matching in Rust and WebAssembly",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/tkhshtsh0917/asearch.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "node": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/node.mjs"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/node.cjs"
        }
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/web.mjs"
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
